@baseUrl = http://localhost:8000

### Root
GET {{baseUrl}}/

### Log in (development only: no password, unknown emails get a new user)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ana@example.com"
}

@token = {{login.response.body.$.access_token}}

### Current user (run "Log in" first, for this and every request below)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Register a pet
# @name registerPet
POST {{baseUrl}}/pets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Rex",
  "species": "dog",
  "birth_date": "2020-05-01",
  "breed": "Beagle"
}

### Get the registered pet (run "Register a pet" first)
GET {{baseUrl}}/pets/{{registerPet.response.body.$.id}}
Authorization: Bearer {{token}}

### List my pets (python -m app.seed gives ana@example.com and bob@example.com a few pets)
# @name pets
GET {{baseUrl}}/pets
Authorization: Bearer {{token}}

### List hospitals and their network
# @name hospitals
GET {{baseUrl}}/hospitals
Authorization: Bearer {{token}}

### List veterinarians and the hospitals they work at
GET {{baseUrl}}/veterinarians
Authorization: Bearer {{token}}

### Veterinarians free at the first hospital at a given time (run "List hospitals" first)
# @name available
GET {{baseUrl}}/veterinarians/available?hospital_id={{hospitals.response.body.$[0].id}}&starts_at=2030-01-01T10:00:00Z&duration_minutes=30
Authorization: Bearer {{token}}

### Schedule an appointment (run "List my pets", "List hospitals" and "Veterinarians free" first)
# @name schedule
POST {{baseUrl}}/appointments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "pet_id": "{{pets.response.body.$[0].id}}",
  "hospital_id": "{{hospitals.response.body.$[0].id}}",
  "veterinarian_id": "{{available.response.body.$[0].id}}",
  "starts_at": "2030-01-01T10:00:00Z",
  "duration_minutes": 30,
  "reason": "Annual vaccines"
}

### Double booking: same veterinarian, overlapping time (409)
POST {{baseUrl}}/appointments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "pet_id": "{{pets.response.body.$[1].id}}",
  "hospital_id": "{{hospitals.response.body.$[0].id}}",
  "veterinarian_id": "{{available.response.body.$[0].id}}",
  "starts_at": "2030-01-01T10:15:00Z",
  "duration_minutes": 30,
  "reason": "Skin allergy follow-up"
}

### List my scheduled appointments
GET {{baseUrl}}/appointments
Authorization: Bearer {{token}}

### Cancel the scheduled appointment (frees its time)
POST {{baseUrl}}/appointments/{{schedule.response.body.$.id}}/cancel
Authorization: Bearer {{token}}

### Invalid payload: unknown species (422)
POST {{baseUrl}}/pets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Rex",
  "species": "dragon"
}

### Domain rule: birth date in the future (422)
POST {{baseUrl}}/pets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Rex",
  "species": "dog",
  "birth_date": "2999-01-01"
}

### Unknown pet (404)
GET {{baseUrl}}/pets/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

### Missing token (401)
GET {{baseUrl}}/auth/me
